# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# PocketBase superuser: signs in to the dashboard at /pb/_/, and LayerLift uses it to write
# job records and read tiers. Use a long random password (at least 10 characters).
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=

# Signs the human-check session cookie. Any long random string, e.g. `openssl rand -hex 32`.
LAYERLIFT_SESSION_SECRET=

# Public address of PocketBase through LayerLift (emails, OAuth2 redirects). Defaults to
# http://localhost:<port>/pb; set it to your site, e.g. https://layerlift.example.com/pb
PB_APP_URL=

# Port LayerLift is published on.
LAYERLIFT_PORT=8000

# Worker processes and the jobs allowed to run or wait at once (server capacity, all tiers).
LAYERLIFT_WORKERS=2
LAYERLIFT_MAX_QUEUE=8

# Serve PocketBase's dashboard at /pb/_/ (it has its own superuser login).
LAYERLIFT_POCKETBASE_DASHBOARD=true

# Optional Cloudflare Turnstile human check for visitors without an account.
LAYERLIFT_TURNSTILE_SITE_KEY=
LAYERLIFT_TURNSTILE_SECRET_KEY=
